# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================

# Login password for the web UI. Also used as the secret that signs JWT tokens,
# so use a long random value (e.g. `openssl rand -hex 32`).
API_AUTH_KEY=your_secure_api_key

# ==========================================
# LLM (AI) CONFIGURATIONS
# ==========================================

# 1. Orchestrator Agent (Ana Ajan - Yüksek kapasiteli model önerilir)
ORCHESTRATOR_BASE_URL=https://openrouter.ai/api/v1
ORCHESTRATOR_API_KEY=your_orchestrator_api_key
ORCHESTRATOR_MODEL=deepseek/deepseek-v4-flash-0731

# 2. Sub-Agents (Alt Ajanlar - Hızlı ve ucuz modeller önerilir)
SUB_AGENT_BASE_URL=https://openrouter.ai/api/v1
SUB_AGENT_API_KEY=your_subagent_api_key
SUB_AGENT_MODEL=deepseek/deepseek-v4-flash-0731

# 3. Title Generator (Sohbet Başlığı Üretici - Hafif modeller önerilir)
TITLE_BASE_URL=https://openrouter.ai/api/v1
TITLE_API_KEY=your_title_api_key
TITLE_MODEL=meta-llama/llama-3.1-8b-instruct

# 4. Voice (Sesli Mod & Dikte) - STT_API_KEY hem STT (Whisper) hem TTS için kullanılır
STT_BASE_URL=https://openrouter.ai/api/v1
STT_API_KEY=your_stt_api_key
STT_MODEL=openai/whisper-1


# ==========================================
# EXCHANGE & TOOLS API KEYS
# ==========================================

BINANCE_SPOT_API_KEY=your_binance_api_key
BINANCE_SPOT_SECRET_KEY=your_binance_secret_key

TAVILY_API_KEY=your_tavily_api_key
COINGECKO_API_KEY=your_coingecko_api_key


# ==========================================
# DATABASE CONFIGURATION
# ==========================================

POSTGRES_USER=swarmuser
POSTGRES_PASSWORD=swarmpassword
POSTGRES_DB=tradeswarm
# Docker Compose overrides DB_HOST with `db`; localhost is for running the backend outside Docker
DB_HOST=localhost
DB_PORT=5432


# ==========================================
# NOTIFICATIONS
# ==========================================

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id


# ==========================================
# OBSERVABILITY (Optional)
# ==========================================

# LangSmith tracing for agent runs
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=TradeSwarm

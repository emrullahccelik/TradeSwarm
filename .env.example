# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================

# Login password for the web UI (required). Use a long random value.
API_AUTH_KEY=your_secure_api_key

# Secret that signs JWT tokens, kept separate from the login password
# (`openssl rand -hex 32`). If unset, API_AUTH_KEY is used as a fallback.
JWT_SECRET=your_random_jwt_secret

# Only needed if the UI is served from a different origin than the Next.js proxy
# (comma-separated, e.g. http://localhost:3001). Leave empty to disable CORS.
CORS_ORIGINS=

# Set to false to make the Trader agent read-only (no order placement or cancellation)
TRADING_ENABLED=true

# ==========================================
# LLM (AI) CONFIGURATIONS
# ==========================================

# 1. Orchestrator Agent (Ana Ajan - Yüksek kapasiteli model önerilir)
ORCHESTRATOR_BASE_URL=https://openrouter.ai/api/v1
ORCHESTRATOR_API_KEY=your_orchestrator_api_key
ORCHESTRATOR_MODEL=deepseek/deepseek-v4-flash-0731
# Max tokens per model response, reasoning included. Stops runaway outputs; raise it if answers get cut off.
ORCHESTRATOR_MAX_TOKENS=8192

# 2. Sub-Agents (Alt Ajanlar - Hızlı ve ucuz modeller önerilir)
SUB_AGENT_BASE_URL=https://openrouter.ai/api/v1
SUB_AGENT_API_KEY=your_subagent_api_key
SUB_AGENT_MODEL=deepseek/deepseek-v4-flash-0731
SUB_AGENT_MAX_TOKENS=8192

# 3. Title Generator (Sohbet Başlığı Üretici - Hafif modeller önerilir)
TITLE_BASE_URL=https://openrouter.ai/api/v1
TITLE_API_KEY=your_title_api_key
TITLE_MODEL=meta-llama/llama-3.1-8b-instruct

# 4. Voice (Sesli Mod & Dikte) - STT_BASE_URL ve STT_API_KEY hem STT (Whisper) hem TTS için kullanılır
STT_BASE_URL=https://openrouter.ai/api/v1
STT_API_KEY=your_stt_api_key
STT_MODEL=openai/whisper-1
TTS_MODEL=google/gemini-3.8-flash-lite-tts
TTS_VOICE=Zephyr


# ==========================================
# EXCHANGE & TOOLS API KEYS
# ==========================================

BINANCE_SPOT_API_KEY=your_binance_api_key
BINANCE_SPOT_SECRET_KEY=your_binance_secret_key

TAVILY_API_KEY=your_tavily_api_key
COINGECKO_API_KEY=your_coingecko_api_key
# demo (free plan) or pro
COINGECKO_API_PLAN=demo


# ==========================================
# DATABASE CONFIGURATION
# ==========================================

POSTGRES_USER=swarmuser
POSTGRES_PASSWORD=swarmpassword
POSTGRES_DB=tradeswarm
# Docker Compose overrides DB_HOST with `db`; localhost is for running the backend outside Docker
DB_HOST=localhost
DB_PORT=5432


# ==========================================
# NOTIFICATIONS
# ==========================================

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id


# ==========================================
# OBSERVABILITY (Optional)
# ==========================================

# LangSmith tracing for agent runs
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=TradeSwarm
